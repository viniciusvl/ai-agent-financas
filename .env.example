# Copie para .env e preencha. O .env NUNCA deve ser commitado.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Segredo aleatório enviado pelo Telegram no header X-Telegram-Bot-Api-Secret-Token
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# URL pública do servidor (sem barra no final), ex.: https://bot.seudominio.com
PUBLIC_BASE_URL=
# IDs de usuários do Telegram autorizados, separados por vírgula (ex.: 111111,222222)
# Envie uma mensagem ao bot: se não estiver autorizado ele responde com o seu ID.
ALLOWED_USER_IDS=

# --- Whisper (STT) — qualquer endpoint compatível com a API da OpenAI ---
WHISPER_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=pt

# --- DeepSeek (extração dos gastos) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Jev (TypeSafe) — roteador leitura/escrita ---
# Sem chave, o roteador usa o fallback no DeepSeek.
TYPESAFE_API_KEY=
# Versão FIXA (nunca jev-latest: o alias muda o modelo sem aviso)
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai
ROUTER_CONFIDENCE_THRESHOLD=0.6

# --- Formato padrão da planilha ---
SHEET_SCHEMA_PATH=config/planilha.yaml

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Gastos

# --- App ---
TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
DB_PATH=data/bot.db
PENDING_TTL_SECONDS=86400
LOG_LEVEL=INFO

